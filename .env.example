# Copy to .env (ignored). Keep real values out of commits and shell history.
ES_URL=https://localhost:19200
ES_USERNAME=elastic
ES_PASSWORD=
# Absolute path to the CA for the existing HTTPS cluster.
ES_CA_CERTS=
ES_INDEX=recipes_clean
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Source data folder containing recipes.parquet. Empty = the repository's data/
# folder. Set an absolute path to keep the data elsewhere. Never commit the data.
DATA_DIR=
# Optional explicit image mapping; default WORK_DIR/derived/image_fallback_v2.sqlite.
RECIPE_IMAGE_FALLBACK_DB=
# Optional absolute path of the generated vocabulary; default WORK_DIR/bm25_vocabulary.json.
BM25_VOCABULARY=
# Generated files root (vocabulary, derived data, caches, outputs).
# Empty = <repo>/var, which git ignores.
WORK_DIR=
# Optional overrides inside/outside WORK_DIR:
OUTPUT_DIR=
# Hugging Face model cache; empty = WORK_DIR/cache/huggingface (var/cache/huggingface).
HF_HOME=
APP_HOST=127.0.0.1
APP_PORT=8001
RECIPE_WARMUP=true
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_GATEWAY_API_KEY=
JEV_API_KEY=
# Container-only overrides: existing ES must be reachable from the container.
# ES_URL=https://host.docker.internal:19200
# CERTS_DIR=/absolute/path/to/public-ca-directory
